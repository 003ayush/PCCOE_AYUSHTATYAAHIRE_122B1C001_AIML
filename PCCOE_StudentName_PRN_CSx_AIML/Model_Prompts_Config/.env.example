# Copy to Model_Prompts_Config/.env and fill in. .env is git-ignored — never commit secrets.

APP_NAME=TARA Assistant
# mock (offline, no key needed) | gemini | groq | openrouter | nvidia
LLM_PROVIDER=mock
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Optional path overrides. Leave blank (or delete the line) to use the
# built-in defaults inside the package; blanks are treated as unset.
INPUT_DATA_DIR=
CHROMA_DIR=
SQLITE_URL=

# OpenAI-compatible endpoint override (optional).
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Provider keys — leave BLANK unless using that provider. Any non-blank
# value (even a placeholder) is treated as a real key and joins the fallback chain.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Optional per-provider model override (defaults: gemini-2.0-flash,
# llama-3.3-70b-versatile, llama-3.3-70b-instruct:free, llama-3.3-70b-instruct).
# Free-tier tip: GROQ_MODEL=llama-3.1-8b-instant has the roomiest daily budget.
# GROQ_MODEL=

# Agentic pipeline bounds (PLAN 5a).
MAX_KNOWLEDGE_ROUNDS=2
KNOWLEDGE_LLM_REWRITE=false
